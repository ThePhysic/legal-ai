FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
ENV NEXT_TELEMETRY_DISABLED=1 API_BASE_URL=http://api:8000
RUN npm run build

FROM node:24-alpine AS runtime
WORKDIR /app
RUN addgroup -g 10001 -S legalai && adduser -S -u 10001 -G legalai legalai
COPY --from=build --chown=legalai:legalai /app/.next/standalone ./
COPY --from=build --chown=legalai:legalai /app/.next/static ./.next/static
COPY --from=build --chown=legalai:legalai /app/public ./public
USER 10001
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]
