FROM ghcr.io/astral-sh/uv:0.13.5 AS uv
FROM python:3.13-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY api ./api
COPY evaluations ./evaluations
COPY corpus ./corpus
COPY migrations ./migrations
COPY infrastructure/entrypoint.sh ./entrypoint.sh
RUN useradd --create-home --uid 10001 legalai && mkdir -p /app/.runtime && chown -R legalai:legalai /app
USER 10001
ENV PATH="/app/.venv/bin:$PATH" LEGAL_AI_RUNTIME_DIR=/app/.runtime LEGAL_AI_CORPUS_PATH=/app/corpus/manifest.json LEGAL_AI_OFFLINE_ONLY=true
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)" || exit 1
CMD ["sh", "/app/entrypoint.sh"]
