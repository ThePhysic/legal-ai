  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "locator": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Locator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AnalysisRequest"
      },
      "AnalysisResponse": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "answer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResearchResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "comparison": {
            "$ref": "#/components/schemas/Comparison"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "document_id",
          "summary",
          "findings",
          "answer",
          "comparison",
          "method",
          "limitations"
        ],
        "title": "AnalysisResponse"
      },
      "Body_upload_v1_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "replace_document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replace Document Id"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_v1_documents_post"
      },
      "Claim": {
        "properties": {
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "passage_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Passage Ids"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Ids"
          },
          "support_status": {
            "type": "string",
            "enum": [
              "verbatim_quote",
              "not_assessed"
            ],
            "title": "Support Status"
          },
          "identity_validated": {
            "type": "boolean",
            "title": "Identity Validated",
            "description": "Source/version/quotation identity only, not semantic verification"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "passage_ids",
          "source_ids",
          "support_status",
          "identity_validated"
        ],
        "title": "Claim"
      },
      "Comparison": {
        "properties": {
          "passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "type": "array",
            "title": "Passages"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "passages",
          "limitations"
        ],
        "title": "Comparison"
      },
      "CorpusResponse": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "coverage": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Coverage"
          },
          "mode": {
            "type": "string",
            "const": "offline",
            "title": "Mode"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "sources",
          "coverage",
          "mode",
          "limitations"
        ],
        "title": "CorpusResponse"
      },
      "Dataset": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "judgment_provenance": {
            "type": "string",
            "title": "Judgment Provenance"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "id",
          "title",
          "revision",
          "count",
          "judgment_provenance"
        ],
        "title": "Dataset"
      },
      "DocumentDetail": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploaded",
              "extracting",
              "chunking",
              "indexing",
              "verifying",
              "ready",
              "failed",
              "deleted",
              "deletion_pending"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "section_count": {
            "type": "integer",
            "title": "Section Count"
          },
          "passage_count": {
            "type": "integer",
            "title": "Passage Count"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "processing": {
            "additionalProperties": true,
            "type": "object",
            "title": "Processing"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "title": "Sections"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "type": "array",
            "title": "Passages"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "document_id",
          "filename",
          "media_type",
          "status",
          "version",
          "content_hash",
          "created_at",
          "section_count",
          "passage_count",
          "error",
          "processing",
          "sections",
          "passages"
        ],
        "title": "DocumentDetail"
      },
      "DocumentListing": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentResponse"
            },
