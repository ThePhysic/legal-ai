# Copying this file does not enable providers. Run scripts/bootstrap.py to generate
# runtime-only local keys/passwords instead of committing any real credentials.
LEGAL_AI_OFFLINE_ONLY=true
LEGAL_AI_RUNTIME_DIR=.runtime
LEGAL_AI_ENCRYPTION_KEY=""
LEGAL_AI_DATABASE_PASSWORD=""
# Existing-index profile only; never provisioned or contacted in this release.
LEGAL_AI_PINECONE_HOST=
LEGAL_AI_PINECONE_API_KEY=""
LEGAL_AI_PINECONE_DIMENSION=1536
LEGAL_AI_PINECONE_EMBEDDING_MODEL=text-embedding-3-small
API_BASE_URL=http://127.0.0.1:8000
